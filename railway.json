{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "service": {
    "name": "ashar-gowd-mcp",
    "port": 3002,
    "healthcheck": {
      "path": "/health",
      "interval": 30,
      "timeout": 10
    },
    "memory": "512Mi"
  }
}
